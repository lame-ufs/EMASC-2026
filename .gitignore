# Versão pública: apenas os materiais finais e suas dependências de execução.
# As fontes LaTeX, figuras auxiliares e notebooks separados ficam no computador.
/.fontes-locais/
/assets/*
!/assets/logo-lame.png
!/assets/logo-emasc.png
/slides/*
!/slides/minicurso-emasc-2026.pdf
/guia-de-apoio/*
