\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeEMASC}[2026/11/18 Tema da LAME para o EMASC 2026]

\RequirePackage{helvet}
\RequirePackage{tikz}
\RequirePackage{listings}
\RequirePackage[skins]{tcolorbox}

\definecolor{emascPurple}{HTML}{302181}
\definecolor{emascCapa}{HTML}{2F2085}
\definecolor{emascBlue}{HTML}{358FD0}
\definecolor{emascTurquoise}{HTML}{76FFDA}
\definecolor{emascGold}{HTML}{FFC51C}
\colorlet{emascNight}{emascPurple!62!black}
\colorlet{emascInk}{emascPurple!60!black}
\colorlet{emascMuted}{emascPurple!56!gray}
\colorlet{emascLine}{emascPurple!20!white}
\colorlet{emascNote}{emascPurple!6!white}
\colorlet{emascCode}{emascBlue!13!white}
\colorlet{emascString}{emascTurquoise!36!black}

\providecommand{\EMASClogo}{logo-lame.png}
\providecommand{\EMASCemail}{lame.ufs.mat@gmail.com}

\usefonttheme{professionalfonts}
\setbeamercolor{normal text}{fg=emascInk,bg=white}
\setbeamercolor{structure}{fg=emascPurple}
\setbeamercolor{frametitle}{fg=emascPurple,bg=}
\setbeamercolor{section in toc}{fg=emascPurple}
\setbeamerfont{frametitle}{size=\Large,series=\bfseries}
\setbeamerfont{section in toc}{size=\large}
\setbeamertemplate{section in toc}[circle]
\setbeamertemplate{navigation symbols}{}
\setbeamercovered{invisible}
\setbeamersize{text margin left=12.5mm,text margin right=12.5mm}

\setbeamertemplate{background canvas}{%
  \begin{tikzpicture}[remember picture,overlay]
    \shade[top color=emascPurple,bottom color=emascBlue]
      (current page.south west) rectangle ([xshift=1.8mm]current page.north west);
    \fill[emascGold] ([yshift=-8mm]current page.north west)
      rectangle ([xshift=1.8mm]current page.north west);
    \node[anchor=north east,inner sep=0pt] at
      ([xshift=-10.5mm,yshift=-3.3mm]current page.north east)
      {\includegraphics[width=10.6mm]{\EMASClogo}};
  \end{tikzpicture}%
}

\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=12.5mm,rightskip=25mm]{frametitle}%
    \vskip3.6mm
    \strut\insertframetitle\strut\par
    \vskip0.5mm
    \hbox{\hskip12.5mm\tikz{%
      \fill[emascGold] (0,0) rectangle (12mm,0.55mm);
      \shade[left color=emascTurquoise,right color=white]
        (12.6mm,0) rectangle (86mm,0.55mm);
    }}%
    \vskip1mm
  \end{beamercolorbox}%
}

\setbeamertemplate{footline}{%
  \hbox to \paperwidth{%
    \hskip12.5mm%
    \color{emascMuted}%
    \vbox{%
      \color{emascLine}\hrule width135mm height0.35pt
      \vskip1.1mm
      \hbox to135mm{%
        \scriptsize\color{emascMuted}%
        \textbf{EMASC 2026}\enspace
        {\color{emascGold}\textbullet}\enspace
        Liga Acadêmica Matemática \& Empresa\enspace
        {\color{emascGold}\textbullet}\enspace UFS%
        \hfil
        \textcolor{emascPurple}{\bfseries\insertframenumber}\,/\,\inserttotalframenumber
      }%
      \vskip1mm
    }%
    \hfil
  }%
}

\newcommand{\EMASCdarkbackground}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[emascCapa]
      (current page.south west) rectangle (current page.north east);
    \node[anchor=north west,inner sep=0pt,opacity=.65] at (current page.north west)
      {\includegraphics[width=60mm]{grafos-emasc.png}};
    \node[anchor=south east,inner sep=0pt,opacity=.65] at (current page.south east)
      {\includegraphics[width=60mm,angle=180]{grafos-emasc.png}};
  \end{tikzpicture}%
}

\newcommand{\EMASCtitlepage}[2][]{%
  \begingroup
  \hypersetup{urlcolor=emascTurquoise}%
  \setbeamertemplate{background canvas}{%
    \EMASCdarkbackground
    \begin{tikzpicture}[remember picture,overlay]
      \begin{scope}[shift={(current page.north west)},x=1mm,y=1mm]
        \node[inner sep=0pt] at (128,-41)
          {\includegraphics[width=43mm]{\EMASClogo}};
        \fill[emascCapa,opacity=.82] (0,-76.5) rectangle (160,-90);
        \draw[white,opacity=.25,line width=.4pt] (12.5,-76.5) -- (147.5,-76.5);
      \end{scope}
    \end{tikzpicture}%
  }%
  \begin{frame}[plain,noframenumbering]
    \begin{tikzpicture}[remember picture,overlay,
      cover text/.style={anchor=north west,inner sep=0pt,align=left}]
      \begin{scope}[shift={(current page.north west)},x=1mm,y=1mm]
        \node[cover text,text=emascGold,font=\small\bfseries]
          at (12.5,-11.5) {EMASC 2026};
        \node[cover text,anchor=west,text width=92mm,text=white]
          at (12.5,-41) {%
            {\raggedright\fontsize{28}{31}\selectfont\bfseries\hyphenpenalty=10000\relax #2\par}%
            \ifblank{#1}{}{\vspace{3mm}{\color{emascTurquoise}\normalsize #1\par}}%
          };
        \node[cover text,text=white!80!emascPurple,font=\small]
          at (12.5,-80.5) {\insertinstitute\enspace\textbullet\enspace UFS};
        \node[anchor=north east,inner sep=0pt,font=\small]
          at (147.5,-80.5) {\href{mailto:\EMASCemail}{\EMASCemail}};
      \end{scope}
    \end{tikzpicture}
  \end{frame}
  \endgroup
}

\newcommand{\EMASCsectionpage}[1]{%
  \begingroup
  \setbeamertemplate{background canvas}{%
    \EMASCdarkbackground
    \begin{tikzpicture}[remember picture,overlay]
      \node[anchor=south west,inner sep=0pt,text=emascTurquoise,
        font=\scriptsize\bfseries] at
        ([xshift=12.5mm,yshift=7mm]current page.south west)
        {EMASC 2026 \textbullet\ LAME};
    \end{tikzpicture}%
  }%
  \begin{frame}[plain,t,noframenumbering]
    \vspace{7mm}
    {\color{emascTurquoise}\small\bfseries #1\par}
    \vspace{4mm}
    {\color{emascGold}\fontsize{38}{42}\selectfont\bfseries
      \ifnum\value{section}<10 0\fi\insertsectionnumber\par}
    {\color{emascTurquoise}\rule{16mm}{0.6pt}}\par
    {\color{white}\LARGE\bfseries
      \let\hyperlink\@secondoftwo\insertsectionhead\par}
  \end{frame}
  \endgroup
}

\newtcolorbox{EMASCnote}{
  enhanced,frame hidden,arc=1mm,boxrule=0pt,boxsep=0pt,
  colback=emascNote,colupper=emascInk,fontupper=\small,
  borderline west={1.4pt}{0pt}{emascGold},
  left=2.7mm,right=2.3mm,top=1.1mm,bottom=1.1mm,
  before skip=1.5mm,after skip=0pt
}

\newcommand{\EMASCcodelabel}[1]{%
  \par\smallskip{\color{emascPurple}\small\bfseries #1}\par\nobreak
}

\lstdefinestyle{EMASC}{
  basicstyle=\ttfamily\footnotesize\color{emascInk},
  keywordstyle=\color{emascPurple}\bfseries,
  stringstyle=\color{emascString},
  commentstyle=\color{emascMuted},
  backgroundcolor=\color{emascCode},
  rulecolor=\color{emascBlue},
  frame=l,
  framerule=1.25pt,
  framesep=4pt,
  xleftmargin=6pt,
  columns=fullflexible,
  keepspaces=true,
  showstringspaces=false,
  upquote=true,
  aboveskip=3pt,
  belowskip=4pt,
  literate=
    {á}{{\'a}}1 {ã}{{\~a}}1 {à}{{\`a}}1 {â}{{\^a}}1
    {é}{{\'e}}1 {ê}{{\^e}}1 {í}{{\'i}}1 {ó}{{\'o}}1
    {ô}{{\^o}}1 {õ}{{\~o}}1 {ú}{{\'u}}1 {ç}{{\c{c}}}1
    {Á}{{\'A}}1 {É}{{\'E}}1 {Ç}{{\c{C}}}1
}
